  "narrative": {
    "northStar": "Cerita Bulan Ini (this month's story)",
    "keyCharacteristics": [
      "One committed ink-blue field for the whole page; white sheets for the work.",
      "Every page answers first in a sentence; the figure the reader came for is lime (coral-soft for a loss).",
