    "rules": [
      {
        "name": "The Field-and-Sheet Rule",
        "section": "colors",
        "body": "On the field use On Field colours inside an `on-field` wrapper; on sheets use the ink scale. Never mix."
      },
      {
        "name": "The Answer-First Rule",
        "section": "layout",
        "body": "Every page states its answer as a sentence on the field before any table; a rounded figure is always followed by the exact one."
      },
      {
        "name": "The One-Answer Rule",
        "section": "layout",
        "body": "One answer per chapter. No grids of metric tiles."
      },
      {
        "name": "The Loss-Contrast Rule",
        "section": "colors",
        "body": "Losses on the field use Coral Soft (5:1); deep Coral is only a background with white text (5.4:1)."
      },
      {
        "name": "The Earned-Motion Rule",
        "section": "motion",
