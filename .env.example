# Salin file ini menjadi .env.local (untuk menjalankan di komputer sendiri),
# atau isi nilai yang sama di Vercel → Settings → Environment Variables.
#
# Ambil dari Supabase → Project Settings → API (atau "API Keys").
# Nilai ini memang terlihat di browser; data tetap aman karena dilindungi login + RLS.
# JANGAN pernah isi dengan service_role / secret key.

# Project URL, mis. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# anon / publishable key (diawali "eyJ..." atau "sb_publishable_...")
VITE_SUPABASE_ANON_KEY=

# --- Opsional: branding (satu kode, dua deploy) --------------------------------
# Nama aplikasi di header, halaman login, dan judul tab. Default "Profit Shopee";
# deploy HitungCuan memakai "HitungCuan" (sekaligus memakai logo dan favicon HitungCuan dari public/logo/).
VITE_APP_NAME=

# Nomor WhatsApp pengelola, format 62... (mis. 6281234567890). Dipakai untuk tombol
# "Hubungi admin", "Perpanjang", dan "Lupa password?". Kosong = hanya teks tanpa tautan.
VITE_SUPPORT_WA=
